---
// Original Tomatick brand mark (glossy tomato) — Claude-made, matches the app
// icon family. Same art drives favicon.svg. §1
interface Props {
  class?: string;
}
const { class: className = 'h-8 w-8' } = Astro.props;
---
<svg viewBox="0 0 64 64" class={className} role="img" aria-label="Tomatick">
  <defs>
    <radialGradient id="tmBody" cx="38%" cy="34%" r="72%">
      <stop offset="0%" stop-color="#ff7a5f" />
      <stop offset="55%" stop-color="#f5402a" />
      <stop offset="100%" stop-color="#c2160b" />
    </radialGradient>
  </defs>
  <!-- leaves -->
  <path
    d="M32 15c-3-6-9-8-13-7 1 5 4 8 9 9-5-1-10 1-13 5 5 3 10 2 14-2-1 3 0 5 3 7 3-2 4-4 3-7 4 4 9 5 14 2-3-4-8-6-13-5 5-1 8-4 9-9-4-1-10 1-13 7z"
    fill="#3d9142"
  />
  <!-- body -->
  <circle cx="32" cy="38" r="22" fill="url(#tmBody)" />
  <!-- shine -->
  <ellipse cx="24" cy="30" rx="7" ry="5" fill="#ffffff" opacity="0.45" transform="rotate(-25 24 30)" />
</svg>
