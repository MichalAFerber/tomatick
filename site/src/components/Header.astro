---
import { SITE } from '../consts';
import TomatoLogo from './TomatoLogo.astro';
import GitHubMark from './GitHubMark.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="sticky top-0 z-40 border-b backdrop-blur" style="border-color: var(--border); background-color: color-mix(in srgb, var(--bg) 85%, transparent);">
  <div class="container-page flex items-center justify-between py-3" style="padding-top: max(0.75rem, env(safe-area-inset-top));">
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-extrabold no-underline" style="color: var(--fg);">
      <TomatoLogo class="h-8 w-8" />
      Tomatick
    </a>
    <nav class="flex items-center gap-1.5 sm:gap-2" aria-label="Primary">
      <a href="/docs/" class="btn !hidden sm:!inline-flex !min-h-[40px] !px-4 !py-2">Quick Start</a>
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener"
        class="btn !min-h-[44px] !min-w-[44px] !px-3 !py-2"
        aria-label="Tomatick on GitHub"
      >
        <GitHubMark class="h-5 w-5" />
      </a>
      <ThemeToggle />
      <a href={SITE.releases} target="_blank" rel="noopener" class="btn btn-primary !min-h-[40px] !px-4 !py-2">Download</a>
    </nav>
  </div>
</header>
